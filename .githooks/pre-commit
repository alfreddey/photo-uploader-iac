#!/usr/bin/env bash
# pre-commit hook (offline): when a commit touches templates/, fold the
# TemplatesVersion bump into THIS commit so the committed deployment file
# already points at the content hash of the templates being committed. Does NO
# AWS work - the S3 upload happens later, in .githooks/pre-push.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Only act when child templates are part of this commit.
staged="$(git diff --cached --name-only -- 'templates/*.yaml' || true)"
[ -n "$staged" ] || exit 0

# Require templates fully staged so the hash matches the committed content.
if ! git diff --quiet -- templates/; then
  echo "[pre-commit] templates/ has unstaged changes; 'git add' them before committing." >&2
  exit 1
fi

echo "[pre-commit] templates/ changed - bumping TemplatesVersion (offline)..."
./deploy/upload-templates.sh bump
git add deployments/root.yaml
